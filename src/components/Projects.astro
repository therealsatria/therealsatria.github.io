---
const projects = [
  // {
  //   title: 'Windows Server Hardening Script',
  //   description:
  //     'A PowerShell toolkit that applies a baseline security configuration to Windows Server hosts: account and audit policies, SMB signing, and unnecessary service reduction. Idempotent, and logs every change for audit purposes.',
  //   tags: ['PowerShell', 'Windows Server', 'Group Policy'],
  //   link: 'https://github.com/therealsatria',
  // },
  {
    title: 'Satria Nugraha | Personal Portfolio Website',
    description:
      'This Astro-powered portfolio and digital CV highlights system administration, Microsoft infrastructure, troubleshooting, and root cause analysis work. Deployed on GitHub Pages.',
    tags: ['Astro', 'CSS', 'GitHub Pages', 'SEO'],
    link: 'https://github.com/therealsatria/therealsatria.github.io',
  },
];
---

<section id="projects" class="section">
  <div class="container">
    <p class="eyebrow">Projects</p>
    <h2 class="section-title">Selected Software &amp; Infrastructure Projects</h2>
    <p class="section-intro">
      A mix of software development and infrastructure/scripting work.
    </p>

    <div
      class="projects-grid"
      aria-label="Software development and IT infrastructure projects by Satria Nugraha"
    >
      {projects.map((project) => (
        <article class="project">
          <h3 class="project-title">{project.title}</h3>
          <p class="project-desc">{project.description}</p>
          <ul class="tags" aria-label="Technologies used">
            {project.tags.map((tag) => (
              <li>{tag}</li>
            ))}
          </ul>
          <p class="project-links">
            <a
              href={project.link}
              target="_blank"
              rel="noopener noreferrer"
            >
              View on GitHub
            </a>
          </p>
        </article>
      ))}
    </div>
  </div>
</section>