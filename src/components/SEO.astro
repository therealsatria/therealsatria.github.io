---
// =============================================================
// SEO.astro - Centralised SEO, Open Graph, Twitter Cards,
// geo tags, and JSON-LD structured data for the entire site.
//
// Usage:
//   <SEO title="..." description="..." ogType="profile" />
// =============================================================

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'profile' | 'article';
  noindex?: boolean;
  keywords?: string[];
}

const {
  title,
  description,
  canonical,
  ogImage = '/og-image.png',
  ogType = 'website',
  noindex = false,
  keywords = [],
} = Astro.props;

// -------------------------------------------------------------
// Canonical URL resolution
// -------------------------------------------------------------
const siteUrl = Astro.site ?? new URL('https://therealsatria.github.io');
const canonicalURL = canonical
  ? new URL(canonical, siteUrl)
  : new URL(Astro.url.pathname, siteUrl);
const ogImageURL = new URL(ogImage, siteUrl);

// -------------------------------------------------------------
// Geo coordinates - Lamongan, East Java, Indonesia
// -------------------------------------------------------------
const GEO = {
  region: 'ID-JI',
  placename: 'Lamongan, East Java, Indonesia',
  lat: '-7.1225',
  lng: '112.3828',
};

// -------------------------------------------------------------
// JSON-LD @graph - semua entitas saling terhubung via @id
// -------------------------------------------------------------
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    // 1. Person - entitas utama
    {
      '@type': 'Person',
      '@id': `${siteUrl.href}#person`,
      name: 'Satria Nugraha',
      givenName: 'Satria',
      familyName: 'Nugraha',
      alternateName: 'therealsatria',
      jobTitle: 'System Administrator & Microsoft Cloud Specialist',
      description:
        'IT professional with experience in system administration, cloud support, and IT infrastructure. Skilled in troubleshooting, server administration, Microsoft 365, Linux, and cloud services. Strong background in root cause analysis and resolving complex technical issues. Based in Lamongan, East Java, Indonesia. Open to System Administrator, Cloud Support, and Infrastructure roles, including international opportunities.',
      url: siteUrl.href,
      image: {
        '@type': 'ImageObject',
        '@id': `${siteUrl.href}#profile-image`,
        url: ogImageURL.href,
        caption: 'Satria Nugraha',
      },
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'Lamongan',
        addressRegion: 'East Java',
        addressCountry: 'ID',
      },
      nationality: {
        '@type': 'Country',
        name: 'Indonesia',
      },
      knowsLanguage: [
        { '@type': 'Language', name: 'Indonesian', alternateName: 'id' },
        { '@type': 'Language', name: 'English', alternateName: 'en' },
      ],
      knowsAbout: [
        'Troubleshooting',
        'Server Administration',
        'Linux Administration',
        'System Administration',
        'IT Infrastructure',
        'Firewalls',
        'Microsoft 365 Administration',
        'Windows Server',
        'Entra ID',
        'Active Directory',
        'Defender for Office 365',
        'Root Cause Analysis',
        'Problem Solving',
        'Critical Thinking',
        'Stakeholder Communication',
        'Network Security',
        'OPNsense',
        'Proxmox',
        'MikroTik',
        'Cloud Support',
      ],
      sameAs: [
        'https://www.linkedin.com/in/satrianug',
        'https://github.com/therealsatria',
      ],
      worksFor: {
        '@type': 'Organization',
        name: 'Self-Employed (IT Freelance)',
        location: {
          '@type': 'Place',
          name: 'Jombang, East Java, Indonesia',
        },
      },
      hasOccupation: {
        '@type': 'Occupation',
        name: 'IT Freelance / System Administrator',
        occupationLocation: {
          '@type': 'Country',
          name: 'Indonesia',
        },
        skills:
          'Troubleshooting, Server Administration, Linux Administration, System Administration, IT Infrastructure, Firewalls, Microsoft 365 Administration, Windows Server, Entra ID, Active Directory, Defender for Office 365, Root Cause Analysis',
      },
      seeks: {
        '@type': 'Demand',
        name: 'System Administrator, Cloud Support, and Infrastructure roles',
        description:
          'Open to System Administrator, Cloud Support, and Infrastructure roles, including remote work and international opportunities (GCC countries, Japan, Malaysia, Singapore, and worldwide).',
        availability: 'https://schema.org/InStock',
        areaServed: [
          { '@type': 'Country', name: 'Kuwait' },
          { '@type': 'Country', name: 'Saudi Arabia' },
          { '@type': 'Country', name: 'United Arab Emirates' },
          { '@type': 'Country', name: 'Japan' },
          { '@type': 'Country', name: 'Malaysia' },
          { '@type': 'Country', name: 'Singapore' },
        ],
      },
    },

    // 2. ProfilePage
    {
      '@type': 'ProfilePage',
      '@id': `${siteUrl.href}#profilepage`,
      url: siteUrl.href,
      name: title,
      description: description,
      dateCreated: '2026-01-01T00:00:00+07:00',
      dateModified: new Date().toISOString(),
      mainEntity: { '@id': `${siteUrl.href}#person` },
      isPartOf: { '@id': `${siteUrl.href}#website` },
      inLanguage: 'en',
      potentialAction: {
        '@type': 'ReadAction',
        target: [siteUrl.href],
      },
    },

    // 3. WebSite
    {
      '@type': 'WebSite',
      '@id': `${siteUrl.href}#website`,
      url: siteUrl.href,
      name: 'Satria Nugraha - System Administrator & Microsoft Cloud Specialist',
      description:
        'Personal portfolio and digital CV of Satria Nugraha, an IT professional specialising in system administration, Microsoft 365, Linux, and IT infrastructure.',
      publisher: { '@id': `${siteUrl.href}#person` },
      inLanguage: 'en',
      copyrightYear: new Date().getFullYear(),
      copyrightHolder: { '@id': `${siteUrl.href}#person` },
    },

    // 4. BreadcrumbList
    {
      '@type': 'BreadcrumbList',
      '@id': `${siteUrl.href}#breadcrumb`,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: siteUrl.href,
        },
      ],
    },

    // 5. ItemList - daftar proyek
    {
      '@type': 'ItemList',
      '@id': `${siteUrl.href}#projects`,
      name: 'Selected Projects',
      description:
        'Selected IT infrastructure and software projects by Satria Nugraha.',
      numberOfItems: 3,
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          item: {
            '@type': 'CreativeWork',
            name: 'Hospital Network Security Infrastructure (OPNsense)',
            description:
              'Designed and implemented network security infrastructure using OPNsense on x86 hardware for a hospital environment, with pre-production validation in a Proxmox lab and MikroTik router configuration.',
            author: { '@id': `${siteUrl.href}#person` },
          },
        },
        {
          '@type': 'ListItem',
          position: 2,
          item: {
            '@type': 'SoftwareSourceCode',
            name: 'Windows Server Hardening Script',
            description:
              'A PowerShell toolkit that applies a baseline security configuration to Windows Server hosts.',
            programmingLanguage: 'PowerShell',
            codeRepository: 'https://github.com/therealsatria',
            author: { '@id': `${siteUrl.href}#person` },
          },
        },
        {
          '@type': 'ListItem',
          position: 3,
          item: {
            '@type': 'WebSite',
            name: 'Personal Portfolio Website',
            description:
              'A single-page, dependency-free landing page built with semantic HTML, modern CSS, and vanilla JavaScript.',
            url: siteUrl.href,
            author: { '@id': `${siteUrl.href}#person` },
          },
        },
      ],
    },
  ],
};
---

<!-- ========================================================= -->
<!-- Charset & viewport -->
<!-- ========================================================= -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<!-- ========================================================= -->
<!-- Title & description -->
<!-- ========================================================= -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- ========================================================= -->
<!-- Author & keywords -->
<!-- ========================================================= -->
<meta name="author" content="Satria Nugraha" />
{keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}

<!-- ========================================================= -->
<!-- Theme colour -->
<!-- ========================================================= -->
<meta name="theme-color" content="#ffffff" />

<!-- ========================================================= -->
<!-- Canonical -->
<!-- ========================================================= -->
<link rel="canonical" href={canonicalURL.href} />

<!-- ========================================================= -->
<!-- Robots -->
<!-- ========================================================= -->
{noindex ? (
  <meta name="robots" content="noindex, nofollow" />
) : (
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
)}

<!-- ========================================================= -->
<!-- Geo tags - Lamongan, East Java -->
<!-- ========================================================= -->
<meta name="geo.region" content={GEO.region} />
<meta name="geo.placename" content={GEO.placename} />
<meta name="geo.position" content={`${GEO.lat};${GEO.lng}`} />
<meta name="ICBM" content={`${GEO.lat}, ${GEO.lng}`} />

<!-- ========================================================= -->
<!-- Open Graph -->
<!-- ========================================================= -->
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.href} />
<meta property="og:image" content={ogImageURL.href} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Satria Nugraha - System Administrator & Microsoft Cloud Specialist" />
<meta property="og:site_name" content="Satria Nugraha" />
<meta property="og:locale" content="en_US" />

<!-- ========================================================= -->
<!-- Twitter Card -->
<!-- ========================================================= -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageURL.href} />
<meta name="twitter:image:alt" content="Satria Nugraha - System Administrator & Microsoft Cloud Specialist" />

<!-- ========================================================= -->
<!-- JSON-LD Structured Data -->
<!-- ========================================================= -->
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData, null, 2)}
/>

<!-- ========================================================= -->
<!-- Sitemap & LLMs discovery -->
<!-- ========================================================= -->
<link
  rel="sitemap"
  type="application/xml"
  title="Sitemap"
  href={`${siteUrl.href}sitemap-index.xml`}
/>
<link
  rel="alternate"
  type="text/markdown"
  title="LLM-friendly content map"
  href={`${siteUrl.href}llms.txt`}
/>