---
const skillGroups = [
  {
    title: 'Infrastructure & Systems',
    items: [
      'System Administration',
      'Windows Server',
      'Linux Administration',
      'Server Administration',
      'IT Infrastructure',
      'Firewalls',
    ],
  },
  {
    title: 'Microsoft Technologies',
    items: [
      'Microsoft 365 Administration',
      'Entra ID',
      'Active Directory',
      'Microsoft Intune',
      'Microsoft Purview',
      'Defender for Office 365',
      'Group Policy (GPO)',
      'PowerShell',
    ],
  },
  {
    title: 'Core Strengths & Practices',
    items: [
      'Troubleshooting',
      'Root Cause Analysis',
      'Problem Solving',
      'Critical Thinking',
      'Stakeholder Communication',
    ],
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <p class="eyebrow">Skills</p>
    <h2 class="section-title">Core Technical Skills</h2>
    <p class="section-intro">
      Focused on system administration, Microsoft infrastructure, and practical troubleshooting.
    </p>

    <div class="skills-grid" aria-label="Core technical skills">
      {skillGroups.map((group) => (
        <div class="skill-card">
          <h3>{group.title}</h3>
          <ul class="skill-list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>