---
const skillGroups = [
  {
    title: 'Infrastructure & Microsoft',
    items: [
      'Windows Server Administration',
      'Microsoft 365 Administration',
      'Entra ID / Active Directory',
      'Intune & Endpoint Management',
      'Group Policy & Basic Hardening',
      'PowerShell Scripting',
    ],
  },
  {
    title: 'Systems & Operations',
    items: [
      'Linux Administration',
      'Troubleshooting & Root Cause Analysis',
      'Server & Network Support',
      'Incident Handling & Escalation',
      'Technical Documentation',
      'End-user Support',
    ],
  },
  {
    title: 'Development & Tools',
    items: [
      'Backend Development (REST API)',
      'Programming Paradigms (OOP, Procedural)',
      'Git & Version Control',
      'HTML, CSS, JavaScript',
      'Docker (Basic)',
      'Virtualization (VMware / Hyper-V / Proxmox)',
    ],
  },
];
---

<section id="skills" class="section">
  <div class="container">
    <p class="eyebrow">Skills</p>
    <h2 class="section-title">Core Technical Skills</h2>
    <p class="section-intro">
      Focused on <strong>system administration</strong>, <strong>Microsoft infrastructure</strong>, 
      and practical troubleshooting — with supporting development capabilities.
    </p>

    <div class="skills-grid" aria-label="Core technical skills">
      {skillGroups.map((group) => (
        <div class="skill-card">
          <h3>{group.title}</h3>
          <ul class="skill-list">
            {group.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>