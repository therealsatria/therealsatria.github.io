---
const links = {
  resume: '/satria-resume.pdf',
  linkedin: 'https://www.linkedin.com/in/satrianug',
  whatsapp:
    'https://wa.me/6281332875050?text=Hi%20Satria%2C%20I%20found%20your%20profile%20and%20would%20like%20to%20discuss%20an%20opportunity.',
};
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-name">Satria Nugraha</h1>
      <h2 class="hero-title">System Administrator &amp; IT Infrastructure Professional</h2>
      <p class="hero-lead">
        I focus on keeping systems reliable and stable - specializing in Microsoft infrastructure, 
        Windows Server, and practical troubleshooting. I also bring solid experience in system 
        administration and supporting development environments.
      </p>

      <span class="status-badge">
        <span class="dot" aria-hidden="true"></span>
        Available for opportunities
      </span>

      <div class="hero-cta" aria-label="Contact options">
        <a
          class="btn btn-primary"
          href={links.resume}
          target="_blank"
          rel="noopener noreferrer"
        >
          View Resume
        </a>
        <a
          class="btn btn-outline"
          href={links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a class="btn btn-outline" href="#contact">Contact</a>
        <button class="btn btn-outline" type="button" data-profile-open>Profile Picture</button>
      </div>
    </div>

    <!-- At a Glance -->
    <aside class="facts" aria-label="Quick facts">
      <h2>At a glance</h2>
      <dl>
        <dt>Location</dt>
        <dd>Lamongan, East Java, Indonesia</dd>

        <dt>Primary focus</dt>
        <dd>System Administration &amp; Microsoft Infrastructure</dd>

        <dt>Secondary focus</dt>
        <dd>Troubleshooting &amp; Software Development</dd>

        <dt>Availability</dt>
        <dd>Remote &amp; relocation - Kuwait, Qatar, Arab Saudi, Dubai, Malaysia, Singapore, worldwide</dd>

        <dt>Visa sponsorship</dt>
        <dd>Required</dd>

        <dt>Notice period</dt>
        <dd>1 month</dd>

        <dt>Languages</dt>
        <dd>Indonesian (native), English (professional)</dd>
      </dl>
    </aside>
  </div>

  <dialog class="profile-modal" data-profile-modal aria-labelledby="profile-modal-title">
    <div class="profile-modal-inner">
      <div class="profile-modal-header">
        <h2 id="profile-modal-title">Profile Picture</h2>
        <button class="modal-close" type="button" data-profile-close aria-label="Close profile picture">
          <span aria-hidden="true">&times;</span>
        </button>
      </div>
      <img
        class="profile-image"
        src="/satria-photo.webp"
        alt="Satria Nugraha"
        width="640"
        height="640"
      />
      <div class="profile-modal-actions">
        <label class="profile-url-label" for="profile-url">Image URL</label>
        <input id="profile-url" class="profile-url" type="text" readonly value="/satria-photo.webp" data-profile-url />
        <button class="btn btn-primary" type="button" data-profile-copy>Copy Image URL</button>
        <p class="copy-status" data-copy-status role="status" aria-live="polite"></p>
      </div>
    </div>
  </dialog>
</section>

<script>
  const modal = document.querySelector('[data-profile-modal]');
  const openButton = document.querySelector('[data-profile-open]');
  const closeButton = document.querySelector('[data-profile-close]');
  const copyButton = document.querySelector('[data-profile-copy]');
  const urlInput = document.querySelector('[data-profile-url]');
  const copyStatus = document.querySelector('[data-copy-status]');

  if (
    modal instanceof HTMLDialogElement &&
    openButton instanceof HTMLButtonElement &&
    closeButton instanceof HTMLButtonElement &&
    copyButton instanceof HTMLButtonElement &&
    urlInput instanceof HTMLInputElement &&
    copyStatus instanceof HTMLElement
  ) {
    const imageUrl = new URL('/satria-photo.webp', window.location.origin).href;
    urlInput.value = imageUrl;

    openButton.addEventListener('click', () => modal.showModal());
    closeButton.addEventListener('click', () => modal.close());

    modal.addEventListener('click', (event) => {
      if (event.target === modal) modal.close();
    });

    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(imageUrl);
        copyStatus.textContent = 'Copied';
      } catch {
        urlInput.select();
        copyStatus.textContent = 'Select and copy the URL manually';
      }
    });
  }
</script>