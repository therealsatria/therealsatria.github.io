---
const links = {
  resume: '/satriapages/satria-resume.pdf',
  linkedin: 'https://www.linkedin.com/in/satrianug',
  whatsapp:
    'https://wa.me/6281332875050?text=Hi%20Satria%2C%20I%20found%20your%20profile%20and%20would%20like%20to%20discuss%20an%20opportunity.',
};
---

<section id="top" class="hero">
  <div class="container hero-grid">
    <div>
      <h1 class="hero-name">Satria Nugraha</h1>
      <p class="hero-title">Software Developer &amp; IT Infrastructure Professional</p>
      <p class="hero-lead">
        I build and maintain the software and systems that keep teams running —
        with a strong focus on reliability, troubleshooting, and root cause
        analysis.
      </p>

      <div class="hero-cta">
        <a
          class="btn btn-primary"
          href={links.resume}
          target="_blank"
          rel="noopener noreferrer"
        >
          View Resume
        </a>
        <a
          class="btn btn-outline"
          href={links.linkedin}
          target="_blank"
          rel="noopener noreferrer"
        >
          LinkedIn
        </a>
        <a class="btn btn-outline" href="#contact">Contact</a>
      </div>
    </div>

    <!-- At a Glance -->
    <aside class="facts" aria-label="Quick facts">
      <h2>At a glance</h2>
      <dl>
        <dt>Location</dt>
        <dd>Lamongan, East Java, Indonesia</dd>

        <dt>Primary focus</dt>
        <dd>Software Development</dd>

        <dt>Secondary focus</dt>
        <dd>System Administration &amp; IT Infrastructure</dd>

        <dt>Availability</dt>
        <dd>Remote &amp; relocation — GCC, Japan, Malaysia, Singapore, worldwide</dd>
      </dl>
    </aside>
  </div>
</section>