---
const contacts = [
  {
    label: 'Email',
    value: 'satrianug@live.com',
    emailUser: 'satrianug',
    emailDomain: 'live.com',
  },
  {
    label: 'WhatsApp',
    value: '+62 813-3287-5050',
    href: 'https://wa.me/6281332875050',
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/satrianug',
    href: 'https://www.linkedin.com/in/satrianug',
  },
  {
    label: 'GitHub',
    value: 'github.com/therealsatria',
    href: 'https://github.com/therealsatria',
  },
];
---

<section id="contact" class="section">
  <div class="container">
    <p class="eyebrow">Contact</p>
    <h2 class="section-title">Get in touch</h2>

    <div class="contact-grid">
      <div class="contact-copy">
        <p class="section-intro">
          I am currently open to full-time roles and contract engagements —
          remote or on-site with relocation. If my background fits a position on
          your team, I would be glad to hear from you.
        </p>
        <p class="contact-note">
          Based in Indonesia and available for international collaboration.
        </p>
      </div>

      <div>
        <ul class="contact-list" aria-label="Contact information for Satria Nugraha">
          {contacts.map((item) => (
            <li>
              <span class="contact-label">{item.label}</span>
              {item.emailUser ? (
                <a
                  href="#"
                  data-email-user={item.emailUser}
                  data-email-domain={item.emailDomain}
                  class="obfuscated-email"
                >
                  satrianug [at] live [dot] com
                </a>
              ) : (
                <a
                  href={item.href}
                  target={item.href?.startsWith('http') ? '_blank' : undefined}
                  rel={item.href?.startsWith('http')
                    ? 'noopener noreferrer'
                    : undefined}
                >
                  {item.value}
                </a>
              )}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.obfuscated-email').forEach((element) => {
    element.addEventListener('click', (event) => {
      event.preventDefault();
      const user = element.getAttribute('data-email-user');
      const domain = element.getAttribute('data-email-domain');
      if (user && domain) window.location.href = `mailto:${user}@${domain}`;
    });
  });
</script>